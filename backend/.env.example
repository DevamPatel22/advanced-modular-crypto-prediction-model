APP_NAME=Advanced Modular Crypto Prediction API
APP_ENV=dev
APP_VERSION=0.1.0
API_PREFIX=/api/v1
DEFAULT_HORIZON=1h
DEFAULT_MODEL_VERSION=daily-bootstrap
SUPPORTED_SYMBOLS=BTC-USD,ETH-USD,SOL-USD
SUPPORTED_HORIZONS=5m,1h,6h,12h,1d,1w,1mo,3mo
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MARKETS_SOURCE_URL=https://api.exchange.coinbase.com/products
SYMBOL_CACHE_TTL_SECONDS=300
MARKET_DATA_SOURCE_BASE_URL=https://api.exchange.coinbase.com
MARKET_DATA_SECONDARY_SOURCE_ENABLED=true
MARKET_DATA_SECONDARY_SOURCE_BASE_URL=https://api.binance.com
MARKET_DATA_SQLITE_PATH=data/market_data.db
MODEL_ARTIFACTS_ROOT=data/models
MODEL_REGISTRY_PATH=data/models/registry.json
MARKET_DATA_DEFAULT_GRANULARITY=1h
MARKET_DATA_DEFAULT_LIMIT=200
TICKER_STREAM_INTERVAL_SECONDS=2
INGESTION_ENABLED=true
INGESTION_QUOTE_CURRENCY=USD
INGESTION_SYMBOL_LIMIT=120
INGESTION_GRANULARITIES=1m,1h,1d
INGESTION_LIMIT_PER_SYMBOL=1500
INGESTION_CYCLE_SECONDS=600
RETRAIN_SCHEDULE_CRON=0 2 * * *
MARTINGALE_GATE_MODE=bootstrap
BOOTSTRAP_PHASE1_HORIZONS=5m,1h,6h,12h
